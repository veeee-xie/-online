const html = document.documentElement;
const themeBtn = document.getElementById('theme-btn');
function applyTheme(force){
  const hour = new Date().getHours();
  let dark = force !== undefined ? force : (hour < 6 || hour >= 18);
  html.setAttribute('data-theme', dark ? 'night' : 'day');
  themeBtn.textContent = dark ? '☀️' : '🌙';
}
applyTheme();
themeBtn.onclick = ()=>{
  const cur = html.getAttribute('data-theme')==='night';
  applyTheme(!cur);
};
// 每分钟检查一次（不强制覆盖手动，仅自动时段切换）
setInterval(()=>{ if(!themeBtn.dataset.manual) applyTheme(); }, 60000);

