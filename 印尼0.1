/* ============ 渲染逐日行程 ============ */
const daysEl = document.getElementById('days');
DAYS.forEach((d,i)=>{
  const el = document.createElement('div');
  el.className='day'; if(i===0) el.classList.add('open');
  el.innerHTML = `
    <div class="day-head" onclick="this.parentNode.classList.toggle('open')">
      <span class="day-dot" style="color:${d.color};background:${d.color}"></span>
      <span class="day-title">Day ${d.n} · ${d.title}</span>
      <span class="day-date">${d.date} · ${d.tz}</span>
    </div>
    <div class="day-body"><div class="day-inner">
      <div class="day-map">
        <svg viewBox="0 0 800 120" style="width:100%;height:auto">
          <line x1="20" y1="60" x2="780" y2="60" stroke="${d.color}" stroke-width="3" stroke-dasharray="8,6" opacity=".6"/>
          ${d.items.map((it,idx)=>{const x=20+idx*(760/(d.items.length-1||1));const mk=it.type==='flight'?'✈️':it.type==='hotel'?'🌙':it.type==='warn'?'⚠️':'●';return `<g><circle cx="${x}" cy="60" r="8" fill="${d.color}" opacity=".9"/><text x="${x}" y="40" text-anchor="middle" font-size="14">${mk}</text><text x="${x}" y="80" text-anchor="middle" font-size="9" fill="#6b7280">${it.t||''}</text></g>`}).join('')}
        </svg>
        <button class="day-map-btn" data-day="${i}">🗺️ 一键打开当日多点导航（Google Maps）</button>
      </div>
      <ul class="tl">
        ${d.items.map(it=>{
          const cls = it.type==='flight'?'flight':it.type==='hotel'?'hotel':it.type==='warn'?'warn':'';
          const locBtn = (it.lat&&it.loc) ? `<span class="t-loc" data-lat="${it.lat}" data-lng="${it.lng}" data-name="${it.loc}">${it.loc}</span>` : '';
          const book = it.book ? `<span class="pill ${it.book.includes('已')?'ok':'warn'} t-book">${it.book}</span>` : '';
          return `<li class="${cls}">
            <span class="t-time">${it.t}<span class="t-tz">${it.tz}</span></span>
            <div class="t-title">${it.title}</div>
            <div class="t-desc">${it.desc||''}</div>
            ${locBtn}${book}
          </li>`;
        }).join('')}
      </ul>
    </div></div>
  `;
  daysEl.appendChild(el);
});

/* ============ 地点点击 → Google Maps 导航 ============ */
document.addEventListener('click',e=>{
  const loc = e.target.closest('.t-loc');
  if(loc){
    const lat=loc.dataset.lat, lng=loc.dataset.lng, name=encodeURIComponent(loc.dataset.name);
    const url=`https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}&destination_place_id=&travelmode=driving&entry=tt`;
    window.open(url,'_blank');
    return;
  }
  const btn = e.target.closest('.day-map-btn');
  if(btn){
    const d = DAYS[btn.dataset.day];
    const pts = d.items.filter(it=>it.lat).map(it=>`${it.lat},${it.lng}`);
    if(pts.length<2){ window.open(`https://www.google.com/maps/search/?api=1&query=${pts[0]}`,'_blank'); return; }
    const origin=pts[0], dest=pts[pts.length-1], wp=pts.slice(1,-1).join('|');
    const url=`https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${dest}&waypoints=${encodeURIComponent(wp)}&travelmode=driving`;
    window.open(url,'_blank');
  }
});

