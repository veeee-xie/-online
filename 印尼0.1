<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0f766e">
<title>印尼12天 · 4人旅行手册</title>
<style>
/* ============ 主题变量 ============ */
:root{
  --bg:#f5f1ea; --bg2:#efe9de; --card:#ffffff; --card2:#fbf7f0;
  --ink:#1f2937; --ink2:#4b5563; --ink3:#6b7280;
  --line:#e5dcc9; --accent:#0f766e; --accent2:#c2410c;
  --warn:#b91c1c; --ok:#15803d; --tag:#fef3c7;
  --shadow:0 4px 20px rgba(0,0,0,.06);
  --shadow2:0 2px 8px rgba(0,0,0,.05);
}
[data-theme="night"]{
  --bg:#0b1120; --bg2:#0f172a; --card:#162032; --card2:#1e293b;
  --ink:#e5e7eb; --ink2:#cbd5e1; --ink3:#94a3b8;
  --line:#334155; --accent:#2dd4bf; --accent2:#f97316;
  --warn:#f87171; --ok:#4ade80; --tag:#422006;
  --shadow:0 4px 20px rgba(0,0,0,.4);
  --shadow2:0 2px 8px rgba(0,0,0,.3);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{
  margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
  background:var(--bg); color:var(--ink); line-height:1.6;
  font-size:15px; -webkit-font-smoothing:antialiased;
  transition:background .4s,color .4s;
}
.wrap{max-width:820px;margin:0 auto;padding:0 16px 80px}
section{margin:0 0 28px}
h2{font-size:20px;margin:0 0 14px;display:flex;align-items:center;gap:8px;font-weight:700}
h2 .n{width:26px;height:26px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;flex:none}
h3{font-size:16px;margin:18px 0 8px}
p{margin:0 0 8px}
small{color:var(--ink3)}
a{color:var(--accent);text-decoration:none}

/* ============ 顶部 ============ */
.topbar{
  position:sticky;top:0;z-index:50;
  background:linear-gradient(135deg,var(--accent),#0d524d);
  color:#fff;padding:14px 16px;
  display:flex;justify-content:space-between;align-items:center;
  box-shadow:0 2px 12px rgba(0,0,0,.15);
  backdrop-filter:saturate(180%);
}
[data-theme="night"] .topbar{background:linear-gradient(135deg,#0f766e,#134e4a)}
.topbar .t{font-size:15px;font-weight:600}
.topbar .s{font-size:11px;opacity:.8;display:block;margin-top:2px}
.theme-btn{
  background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.25);
  color:#fff;border-radius:20px;padding:6px 12px;font-size:12px;cursor:pointer;
}

/* ============ 此刻关注 ============ */
#now-watch{padding:0 0 8px}
.nw-card{
  background:linear-gradient(135deg,var(--card),var(--card2));
  border-radius:18px;padding:22px 20px;box-shadow:var(--shadow);
  border:1px solid var(--line);text-align:center;overflow:hidden;position:relative;
}
.nw-card::before{content:"";position:absolute;top:-40px;right:-40px;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,rgba(15,118,110,.08),transparent 70%)}
.nw-label{font-size:12px;color:var(--ink3);letter-spacing:2px;margin-bottom:8px}
.nw-event{font-size:18px;font-weight:700;margin-bottom:6px;color:var(--accent)}
.nw-when{font-size:13px;color:var(--ink2);margin-bottom:18px}
.nw-count{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
.nw-unit{background:var(--bg2);border-radius:14px;padding:10px 14px;min-width:64px;border:1px solid var(--line)}
.nw-num{font-size:30px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;line-height:1}
.nw-cap{font-size:11px;color:var(--ink3);margin-top:4px}
.nw-tz{font-size:11px;color:var(--ink3);margin-top:14px}

/* ============ 总览地图 ============ */
.map-wrap{
  background:var(--card);border-radius:18px;padding:14px;box-shadow:var(--shadow2);
  border:1px solid var(--line);overflow:hidden;
}
.svg-map{width:100%;height:auto;display:block}
.map-legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:12px;font-size:11px;color:var(--ink2)}
.map-legend span{display:flex;align-items:center;gap:5px}
.map-legend i{width:14px;height:3px;border-radius:2px;display:inline-block}

/* ============ 卡片通用 ============ */
.card{background:var(--card);border-radius:14px;padding:16px;box-shadow:var(--shadow2);border:1px solid var(--line);margin-bottom:12px}
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{text-align:left;padding:8px 6px;border-bottom:2px solid var(--line);color:var(--ink2);font-size:12px;text-transform:uppercase;letter-spacing:.5px}
.tbl td{padding:9px 6px;border-bottom:1px solid var(--line);vertical-align:top}
.tbl tr:last-child td{border-bottom:none}
.pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;background:var(--tag);color:var(--accent2);font-weight:600}
.pill.ok{background:#dcfce7;color:var(--ok)}[data-theme="night"] .pill.ok{background:#052e16}
.pill.warn{background:#fee2e2;color:var(--warn)}[data-theme="night"] .pill.warn{background:#450a0a}
.pill.todo{background:#e0e7ff;color:#4338ca}[data-theme="night"] .pill.todo{background:#1e1b4b}

/* ============ 逐日行程 ============ */
.day{margin-bottom:24px}
.day-head{
  display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:12px;
  background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow2);
  cursor:pointer;position:relative;
}
.day-head::after{content:"▾";margin-left:auto;color:var(--ink3);transition:transform .3s;font-size:14px}
.day.open .day-head::after{transform:rotate(180deg)}
.day-dot{width:14px;height:14px;border-radius:50%;flex:none;border:3px solid var(--bg);box-shadow:0 0 0 2px currentColor}
.day-title{font-weight:700;font-size:15px;flex:none}
.day-date{font-size:12px;color:var(--ink3);margin-left:auto;margin-right:8px}
.day-body{max-height:0;overflow:hidden;transition:max-height .4s ease}
.day.open .day-body{max-height:9999px}
.day-inner{padding:10px 4px 4px}
.day-map{background:var(--card2);border-radius:12px;padding:10px;margin-bottom:12px;border:1px solid var(--line)}
.day-map-btn{display:block;width:100%;margin-top:8px;padding:8px;border:1px dashed var(--line);border-radius:8px;background:transparent;color:var(--accent);font-size:12px;cursor:pointer}

.tl{position:relative;padding-left:20px;margin:0;list-style:none}
.tl::before{content:"";position:absolute;left:6px;top:6px;bottom:6px;width:2px;background:var(--line)}
.tl li{position:relative;margin-bottom:12px;padding-left:8px}
.tl li::before{content:"";position:absolute;left:-17px;top:7px;width:10px;height:10px;border-radius:50%;background:var(--accent);border:2px solid var(--card)}
.tl li.flight::before{background:var(--accent2)}
.tl li.hotel::before{background:#7c3aed}
.tl li.warn::before{background:var(--warn)}
.t-time{font-size:12px;color:var(--accent);font-weight:700;font-variant-numeric:tabular-nums;display:block}
.t-tz{font-size:10px;color:var(--ink3);margin-left:6px;font-weight:400}
.t-title{font-size:14px;font-weight:600;margin:1px 0 2px}
.t-desc{font-size:12px;color:var(--ink2)}
.t-loc{display:inline-flex;align-items:center;gap:4px;margin-top:5px;font-size:11px;color:var(--accent);background:var(--bg2);padding:3px 8px;border-radius:10px;border:1px solid var(--line);cursor:pointer}
.t-loc:active{transform:scale(.97)}
.t-loc::before{content:"📍"}
.t-book{margin-left:6px}

/* ============ 待办 ============ */
.todo li{padding:9px 10px;border-bottom:1px solid var(--line);display:flex;gap:9px;align-items:flex-start;font-size:13px;cursor:pointer;user-select:none;transition:.15s}
.todo li:last-child{border-bottom:none}
.todo li:hover{background:var(--card2)}
.todo li.done .todo-txt{text-decoration:line-through;opacity:.4}
.todo li.done .todo-desc{opacity:.35}
.todo .cb{flex:none;width:20px;height:20px;border-radius:5px;border:2px solid var(--ink3);margin-top:1px;display:flex;align-items:center;justify-content:center;font-size:13px;color:transparent;transition:.15s;line-height:1}
.todo li.done .cb{background:var(--accent);border-color:var(--accent);color:#fff}
.todo .pri{flex:none;width:22px;height:22px;border-radius:6px;background:var(--tag);color:var(--accent2);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700}
.todo .pri.p0{background:#fecaca;color:var(--warn)}[data-theme="night"] .todo .pri.p0{background:#7f1d1d;color:#fecaca}
.todo .pri.p1{background:#fed7aa;color:#c2410c}
.todo .body{flex:1;min-width:0}
.todo .body small{opacity:.7}

/* ============ 贴士 ============ */
.tip{padding:10px 12px;background:var(--card2);border-radius:10px;margin-bottom:8px;border-left:3px solid var(--accent);font-size:13px}
.tip b{color:var(--accent2)}

/* ============ 部署 ============ */
.steps{counter-reset:s}
.steps li{position:relative;padding:10px 10px 10px 42px;margin-bottom:8px;background:var(--card2);border-radius:10px;border:1px solid var(--line);font-size:13px;list-style:none}
.steps li::before{counter-increment:s;content:counter(s);position:absolute;left:8px;top:10px;width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700}
.steps li.must::after{content:"电脑";position:absolute;right:8px;top:8px;background:var(--warn);color:#fff;font-size:10px;padding:1px 6px;border-radius:4px}
code{background:var(--bg2);padding:1px 5px;border-radius:4px;font-size:12px;color:var(--accent2)}

/* ============ 响应 ============ */
@media(max-width:480px){
  .nw-num{font-size:26px;min-width:56px}
  .nw-unit{padding:8px 10px;min-width:56px}
  h2{font-size:18px}
  .tbl{font-size:12px}
}
@media(min-width:700px){
  body{font-size:16px}
  .day-date{position:absolute;right:32px}
}
</style>
</head>
<body>

<div class="topbar">
  <div>
    <div class="t">🇮🇩 印尼12天 · 4人旅行手册</div>
    <div class="s" id="topbar-sub">9/25 广州出发 → 10/6 抵港</div>
  </div>
  <button class="theme-btn" id="theme-btn">🌙</button>
</div>

<div class="wrap">

<!-- ============ 1. 此刻关注 ============ -->
<section id="now-watch">
  <h2><span class="n">1</span>此刻关注</h2>
  <div class="nw-card">
    <div class="nw-label">下一项行程</div>
    <div class="nw-event" id="nw-event">加载中…</div>
    <div class="nw-when" id="nw-when"></div>
    <div class="nw-count" id="nw-count"></div>
    <div class="nw-tz" id="nw-tz"></div>
  </div>
</section>

<!-- ============ 2. 行程总览地图 ============ -->
<section>
  <h2><span class="n">2</span>行程总览地图</h2>
  <div class="map-wrap">
    <svg class="svg-map" viewBox="0 0 800 460" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" result="n"/>
          <feDisplacementMap in="SourceGraphic" in2="n" scale="3.5"/>
        </filter>
        <pattern id="sea" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="10" cy="10" r="0.8" fill="currentColor" opacity=".15"/>
        </pattern>
      </defs>

      <!-- 海洋背景 -->
      <rect width="800" height="460" fill="currentColor" opacity="0"/>
      <rect width="800" height="460" fill="url(#sea)" style="color:#7dd3fc" opacity=".4"/>

      <!-- 爪哇岛 (手绘感) -->
      <path d="M120,210 C160,180 200,175 240,185 C280,195 320,180 360,190 C400,200 440,195 480,205 C520,215 540,230 520,245 C500,260 460,255 420,250 C380,245 340,255 300,250 C260,245 220,255 180,245 C150,238 130,225 120,210 Z"
            fill="#fde68a" stroke="#a16207" stroke-width="1.5" filter="url(#rough)" opacity=".85"/>
      <!-- 巴厘岛 -->
      <path d="M560,255 C580,245 610,245 630,255 C645,263 645,278 625,285 C605,290 580,288 565,278 C555,270 555,262 560,255 Z"
            fill="#fbcfe8" stroke="#be185d" stroke-width="1.5" filter="url(#rough)" opacity=".85"/>
      <!-- 弗洛雷斯/科莫多 -->
      <path d="M680,270 C710,258 750,260 770,272 C780,280 770,295 750,300 C720,308 690,302 678,290 C672,283 675,275 680,270 Z"
            fill="#bbf7d0" stroke="#15803d" stroke-width="1.5" filter="url(#rough)" opacity=".85"/>
      <!-- 香港/广州小标 -->
      <circle cx="90" cy="110" r="6" fill="#64748b" filter="url(#rough)"/>

      <!-- 城市标记 -->
      <g font-family="system-ui" font-size="11" fill="#1f2937">
        <circle cx="160" cy="215" r="3.5" fill="#0f766e"/><text x="167" y="219">雅加达</text>
        <circle cx="300" cy="218" r="3.5" fill="#0f766e"/><text x="307" y="222">日惹</text>
        <circle cx="440" cy="222" r="3.5" fill="#0f766e"/><text x="447" y="226">泗水</text>
        <circle cx="485" cy="228" r="3.5" fill="#c2410c"/><text x="492" y="232">布罗莫</text>
        <circle cx="600" cy="270" r="3.5" fill="#0f766e"/><text x="607" y="274">巴厘岛</text>
        <circle cx="725" cy="282" r="3.5" fill="#0f766e"/><text x="732" y="286">科莫多</text>
        <circle cx="90" cy="110" r="3.5" fill="#475569"/><text x="100" y="114">广州/香港</text>
      </g>

      <!-- 航线 (虚线) -->
      <g fill="none" stroke-dasharray="4,4" stroke-width="1.8" opacity=".75">
        <path d="M93,113 C120,160 140,200 160,212" stroke="#E63946"/>
        <path d="M165,215 C200,200 250,200 298,217" stroke="#E63946"/>
        <path d="M445,222 C480,240 520,260 597,268" stroke="#7209B7"/>
        <path d="M600,270 C640,275 680,280 722,282" stroke="#023E8A"/>
        <path d="M598,268 C400,200 200,130 93,112" stroke="#6C757D" stroke-dasharray="3,5"/>
      </g>

      <!-- 住宿标记 (月亮) -->
      <g font-size="13">
        <text x="295" y="240" fill="#7c3aed">🌙</text>
        <text x="478" y="245" fill="#7c3aed">🌙</text>
        <text x="720" y="300" fill="#7c3aed">🌙</text>
        <text x="595" y="288" fill="#7c3aed">🌙🌙</text>
      </g>
    </svg>
    <div class="map-legend">
      <span><i style="background:#E63946"></i>9/25 出发航线</span>
      <span><i style="background:#F77F00"></i>9/26 寺庙日</span>
      <span><i style="background:#C1421F"></i>9/27 火山</span>
      <span><i style="background:#4361EE"></i>9/28 火车东进</span>
      <span><i style="background:#06A77D"></i>9/29 瀑布</span>
      <span><i style="background:#7209B7"></i>9/30 布罗莫→科莫多</span>
      <span><i style="background:#023E8A"></i>10/1-2 科莫多船游</span>
      <span><i style="background:#E76F51"></i>10/3-5 巴厘岛</span>
      <span><i style="background:#6C757D"></i>10/6 回程</span>
      <span>🌙 当晚住宿</span>
    </div>
  </div>
</section>

<!-- ============ 3. 已确认预订 ============ -->
<section>
  <h2><span class="n">3</span>已确认预订</h2>
  <p style="font-size:12px;color:var(--ink3);margin-bottom:12px">仅显示公开信息（时间、地点、航司），确认号/证件号不写进页面</p>

  <h3>✈️ 机票（5段）</h3>
  <div class="card">
    <table class="tbl">
      <thead><tr><th>日期</th><th>航班</th><th>出发→到达</th><th>时长</th><th>状态</th></tr></thead>
      <tbody>
        <tr><td>9/25</td><td>8B861 狮航</td><td>02:30 广州CAN·T2 → 06:40 雅加达CGK·T3</td><td>5h10m</td><td><span class="pill ok">已出票</span></td></tr>
        <tr><td>9/25</td><td>8B5530 狮航</td><td>10:40 雅加达CGK·T3 → 11:50 日惹YIA</td><td>1h10m</td><td><span class="pill ok">已出票</span></td></tr>
        <tr><td>9/30</td><td>IU726 Super Air Jet</td><td>15:30 泗水SUB → 18:00 科莫多LBJ</td><td>1h30m</td><td><span class="pill ok">已出票</span></td></tr>
        <tr><td>10/3</td><td>QZ643 亚航</td><td>10:35 科莫多LBJ → 11:45 巴厘岛DPS</td><td>1h10m</td><td><span class="pill ok">已出票</span></td></tr>
        <tr><td>10/6</td><td>SQ949+SQ894 新航</td><td>07:15 巴厘岛DPS → 10:00 新加坡SIN → 17:05 香港HKG</td><td>共9h50m</td><td><span class="pill ok">已出票</span></td></tr>
      </tbody>
    </table>
  </div>

  <h3>🚄 火车</h3>
  <div class="card">
    <table class="tbl">
      <thead><tr><th>日期</th><th>车次</th><th>出发→到达</th><th>舱位</th><th>状态</th></tr></thead>
      <tbody>
        <tr><td>9/28</td><td>Argo Wilis Panoramic</td><td>13:37 日惹YK → 17:25 泗水SGU</td><td>Executive</td><td><span class="pill ok">已出票</span></td></tr>
      </tbody>
    </table>
  </div>

  <h3>🏨 酒店（5家·共11晚）</h3>
  <div class="card">
    <table class="tbl">
      <thead><tr><th>区域</th><th>酒店</th><th>入住→退房</th><th>夜</th><th>状态</th></tr></thead>
      <tbody>
        <tr><td>日惹</td><td>The Rich Jogja Hotel</td><td>9/25 → 9/28</td><td>3</td><td><span class="pill ok">已确认</span></td></tr>
        <tr><td>布罗莫</td><td>Arnez Tropical Cottage (Cemoro Lawang)</td><td>9/28 → 9/30</td><td>2</td><td><span class="pill warn">待确认房间数</span></td></tr>
        <tr><td>科莫多</td><td>Inn Room Bajo Hotel (Jl. Soekarno Hatta 86)</td><td>9/30 → 10/3</td><td>3</td><td><span class="pill ok">已确认</span></td></tr>
        <tr><td>巴厘岛·机场</td><td>Grandmas Plus Hotel Airport</td><td>10/3 → 10/4</td><td>1</td><td><span class="pill ok">已确认</span></td></tr>
        <tr><td>巴厘岛·Kuta</td><td>Discovery Kartika Plaza Hotel</td><td>10/4 → 10/6</td><td>2</td><td><span class="pill ok">已确认</span></td></tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ============ 4. 逐日行程 ============ -->
<section>
  <h2><span class="n">4</span>逐日行程</h2>
  <p style="font-size:12px;color:var(--ink3);margin-bottom:12px">点击每日标题展开当日路线地图；每个 📍 地点可点击唤起 Google 地图导航</p>
  <div id="days"></div>
</section>

<!-- ============ 5. 待办清单 ============ -->
<section>
  <h2><span class="n">5</span>待办清单</h2>
  <p style="font-size:12px;color:var(--ink3);margin-bottom:12px">点一下勾选已办完的项（勾选只存在本机浏览器，4人各自进度不同步）。有要改的地方仍告诉我，我改页面</p>
  <div class="card">
    <ul class="todo" id="todo" style="list-style:none;padding:0;margin:0"></ul>
  </div>
</section>

<!-- ============ 6. 实用贴士 ============ -->
<section>
  <h2><span class="n">6</span>实用贴士</h2>
  <div class="card">
    <div class="tip"><b>时区</b>：日惹/泗水/雅加达为 WIB（UTC+7），科莫多/巴厘岛为 WITA（UTC+8）。9/30 飞科莫多时钟会"凭空多1小时"——别误以为算错。</div>
    <div class="tip"><b>签证</b>：eVOA 电子落地签 30 天，4人各1份，须在 12/11/2026 前使用。落地雅加达走 Autogate 自助通关，省 30-60min。需出示回程机票（10/6 DPS→HKG）+ 护照（剩余有效期 &gt; 6 个月）。</div>
    <div class="tip"><b>通讯</b>：Telkomsel 10天 45元 10G，落地雅加达 CGK 机场或日惹市区便利店激活。</div>
