];
function fmt(n){return String(n).padStart(2,'0')}
function tick(){
  const now = Date.now();
  let next = EVENTS.find(e => new Date(e.iso).getTime() > now);
  const nwEvent = document.getElementById('nw-event');
  const nwWhen = document.getElementById('nw-when');
  const nwCount = document.getElementById('nw-count');
  const nwTz = document.getElementById('nw-tz');
  if(!next){
    nwEvent.textContent='🎉 旅途已结束';
    nwWhen.textContent='2026/9/25 - 10/6 · 印尼12天';
    nwCount.innerHTML='<div class="nw-unit"><div class="nw-num">✓</div><div class="nw-cap">完成</div></div>';
    nwTz.textContent='';
    return;
  }
  const target = new Date(next.iso).getTime();
  const diff = target - now;
  const d = Math.floor(diff/86400000);
  const h = Math.floor(diff%86400000/3600000);
  const m = Math.floor(diff%3600000/60000);
  const s = Math.floor(diff%60000/1000);
  nwEvent.textContent = next.title;
  const dt = new Date(next.iso);
  const localStr = `${dt.getFullYear()}/${fmt(dt.getMonth()+1)}/${fmt(dt.getDate())} ${fmt(dt.getHours())}:${fmt(dt.getMinutes())}`;
  nwWhen.textContent = `${localStr}（你当前时区显示）`;
  nwCount.innerHTML = `
    <div class="nw-unit"><div class="nw-num">${d}</div><div class="nw-cap">天</div></div>
    <div class="nw-unit"><div class="nw-num">${fmt(h)}</div><div class="nw-cap">时</div></div>
    <div class="nw-unit"><div class="nw-num">${fmt(m)}</div><div class="nw-cap">分</div></div>
    <div class="nw-unit"><div class="nw-num">${fmt(s)}</div><div class="nw-cap">秒</div></div>`;
  nwTz.textContent = `${next.where} · 原始时区 ${next.tz}`;
}
tick();
setInterval(tick,1000);

