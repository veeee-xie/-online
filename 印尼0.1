const todoEl = document.getElementById('todo');
const TODO_KEY='indo-trip-todo-done-v1';
let _done;
try{_done=new Set(JSON.parse(localStorage.getItem(TODO_KEY)||'[]'));}catch(e){_done=new Set();}
TODO.forEach((t,i)=>{
  const li=document.createElement('li');
  if(_done.has(i))li.className='done';
  li.innerHTML=`<span class="cb">✓</span><span class="pri ${t.p==='P0'?'p0':'p1'}">${t.p}</span><div class="body"><div class="todo-txt">${t.t}</div><small class="todo-desc">${t.d}</small></div>`;
  li.addEventListener('click',()=>{
    if(_done.has(i)){_done.delete(i);li.classList.remove('done');}
    else{_done.add(i);li.classList.add('done');}
    try{localStorage.setItem(TODO_KEY,JSON.stringify([..._done]));}catch(e){}
  });
  todoEl.appendChild(li);
});

